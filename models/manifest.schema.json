{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foyer-labs/PhotoFlow/models/manifest.schema.json",
  "title": "PhotoFlow model manifest",
  "type": "object",
  "required": ["manifestVersion", "verifiedOn", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "manifestVersion": { "const": 1 },
    "verifiedOn": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": ["id", "function", "name", "version", "phase", "adapter", "license", "files"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "function": { "enum": ["ObjectDetection", "Faces", "Embedding", "Tagger", "Caption", "Vlm", "Ocr", "Aesthetic", "FaceRecognition"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "phase": { "type": "integer", "minimum": 1, "maximum": 5 },
        "defaultFor": { "enum": ["cpu", "gpu", "any", "permissive-alternative"] },
        "adapter": { "type": "string", "minLength": 1 },
        "install": { "enum": ["download", "manual-convert"], "description": "download (default): fetched by the app; manual-convert: the original files are downloaded (by the user or by the app on request), the app verifies and converts them (phase 5b)." },
        "output": { "type": "string", "minLength": 1, "description": "manual-convert: the file the conversion leaves in the model folder (default genai_config.json)." },
        "license": { "$ref": "#/$defs/license" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "io": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "required": ["spdx", "source", "commercialUse", "requiresAcceptance"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^https://" },
        "commercialUse": { "type": "boolean" },
        "requiresAcceptance": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "commercialUse": { "const": false } } },
      "then": { "properties": { "requiresAcceptance": { "const": true } } }
    },
    "file": {
      "type": "object",
      "required": ["path", "url", "sha256", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "archive": { "enum": ["zip"] },
        "use": { "type": "array", "items": { "type": "string" } },
        "mirrors": { "type": "array", "items": { "type": "string", "pattern": "^https://" } }
      }
    }
  }
}
