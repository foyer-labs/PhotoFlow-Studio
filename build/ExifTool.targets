<Project>
  <!--
    SPDX-License-Identifier: Apache-2.0
    exiftool provisioning (spec §11, decision F1-5): downloaded once per machine, version pinned, SHA-256 verified,
    then copied next to the application under tools/exiftool. No binary is ever stored in the repository.

    Flavors:
      windows-exe : standalone Windows build from SourceForge (hash from https://exiftool.org/checksums.txt).
                    Used for local Windows builds and the Windows package.
      perl        : Perl distribution from the author's official GitHub repository (tag archive, pinned hash).
                    Used on Linux/macOS and in CI (SourceForge rejects CI runners); needs perl on the machine.
  -->
  <PropertyGroup>
    <ExifToolVersion>13.59</ExifToolVersion>
    <ExifToolCacheRoot Condition="'$(ExifToolCacheRoot)' == '' and '$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\PhotoFlow.Build</ExifToolCacheRoot>
    <ExifToolCacheRoot Condition="'$(ExifToolCacheRoot)' == ''">$(HOME)/.cache/PhotoFlow.Build</ExifToolCacheRoot>
    <ExifToolFlavor Condition="'$(ExifToolFlavor)' == '' and $([MSBuild]::IsOSPlatform('Windows')) and '$(CI)' != 'true'">windows-exe</ExifToolFlavor>
    <ExifToolFlavor Condition="'$(ExifToolFlavor)' == ''">perl</ExifToolFlavor>

    <ExifToolArchive Condition="'$(ExifToolFlavor)' == 'windows-exe'">exiftool-$(ExifToolVersion)_64.zip</ExifToolArchive>
    <ExifToolUrl Condition="'$(ExifToolFlavor)' == 'windows-exe'">https://sourceforge.net/projects/exiftool/files/$(ExifToolArchive)/download</ExifToolUrl>
    <ExifToolSha256 Condition="'$(ExifToolFlavor)' == 'windows-exe'">44B512B25AF500724BA579D0A53C8FC5851628B692DD5E5D94AE4A15C2CBA9EC</ExifToolSha256>
    <ExifToolPayloadDir Condition="'$(ExifToolFlavor)' == 'windows-exe'">exiftool-$(ExifToolVersion)_64</ExifToolPayloadDir>
    <ExifToolMainFile Condition="'$(ExifToolFlavor)' == 'windows-exe'">exiftool.exe</ExifToolMainFile>
    <ExifToolSupportDir Condition="'$(ExifToolFlavor)' == 'windows-exe'">exiftool_files</ExifToolSupportDir>

    <ExifToolArchive Condition="'$(ExifToolFlavor)' == 'perl'">exiftool-$(ExifToolVersion)-src.tar.gz</ExifToolArchive>
    <ExifToolUrl Condition="'$(ExifToolFlavor)' == 'perl'">https://github.com/exiftool/exiftool/archive/refs/tags/$(ExifToolVersion).tar.gz</ExifToolUrl>
    <ExifToolSha256 Condition="'$(ExifToolFlavor)' == 'perl'">87D3317882FDAE9CB4DCFE57A96A378D0132FFC02C731315BF128B19DDCF7AAC</ExifToolSha256>
    <ExifToolPayloadDir Condition="'$(ExifToolFlavor)' == 'perl'">exiftool-$(ExifToolVersion)</ExifToolPayloadDir>
    <ExifToolMainFile Condition="'$(ExifToolFlavor)' == 'perl'">exiftool</ExifToolMainFile>
    <ExifToolSupportDir Condition="'$(ExifToolFlavor)' == 'perl'">lib</ExifToolSupportDir>

    <ExifToolCacheDir>$([MSBuild]::NormalizeDirectory('$(ExifToolCacheRoot)', 'exiftool-$(ExifToolVersion)-$(ExifToolFlavor)'))</ExifToolCacheDir>
    <ExifToolExtractedMarker>$(ExifToolCacheDir)extracted.ok</ExifToolExtractedMarker>
  </PropertyGroup>

  <Target Name="PhotoFlowProvisionExifTool" BeforeTargets="AssignTargetPaths" Condition="'$(PhotoFlowSkipExifTool)' != 'true'">
    <MakeDir Directories="$(ExifToolCacheDir)" />

    <DownloadFile Condition="!Exists('$(ExifToolExtractedMarker)')"
                  SourceUrl="$(ExifToolUrl)" DestinationFolder="$(ExifToolCacheDir)" DestinationFileName="$(ExifToolArchive)" Retries="3" />
    <GetFileHash Condition="!Exists('$(ExifToolExtractedMarker)')" Files="$(ExifToolCacheDir)$(ExifToolArchive)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="_ExifToolActualHash" />
    </GetFileHash>
    <Error Condition="!Exists('$(ExifToolExtractedMarker)') and '$(_ExifToolActualHash)' != '$(ExifToolSha256)'"
           Text="exiftool archive SHA-256 mismatch: expected $(ExifToolSha256), got $(_ExifToolActualHash)." />
    <Unzip Condition="!Exists('$(ExifToolExtractedMarker)') and '$(ExifToolFlavor)' == 'windows-exe'"
           SourceFiles="$(ExifToolCacheDir)$(ExifToolArchive)" DestinationFolder="$(ExifToolCacheDir)" OverwriteReadOnlyFiles="true" />
    <Copy Condition="!Exists('$(ExifToolExtractedMarker)') and '$(ExifToolFlavor)' == 'windows-exe'"
          SourceFiles="$(ExifToolCacheDir)$(ExifToolPayloadDir)\exiftool(-k).exe"
          DestinationFiles="$(ExifToolCacheDir)$(ExifToolPayloadDir)\exiftool.exe" />
    <Exec Condition="!Exists('$(ExifToolExtractedMarker)') and '$(ExifToolFlavor)' == 'perl'"
          Command="tar -xzf &quot;$(ExifToolArchive)&quot;" WorkingDirectory="$(ExifToolCacheDir)" />
    <Touch Condition="!Exists('$(ExifToolExtractedMarker)')" Files="$(ExifToolExtractedMarker)" AlwaysCreate="true" />

    <ItemGroup>
      <_ExifToolSupport Include="$(ExifToolCacheDir)$(ExifToolPayloadDir)/$(ExifToolSupportDir)/**/*" />
      <None Include="$(ExifToolCacheDir)$(ExifToolPayloadDir)/$(ExifToolMainFile)" Link="tools/exiftool/$(ExifToolMainFile)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
      <None Include="@(_ExifToolSupport)"
            Link="tools/exiftool/$(ExifToolSupportDir)/%(_ExifToolSupport.RecursiveDir)%(_ExifToolSupport.Filename)%(_ExifToolSupport.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
