<Project>
  <!-- Central package management: every version is pinned here (verified on nuget.org, 2026-10-12). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup Label="Hosting and logging">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Imaging and inference">
    <!-- SkiaSharp aligned with the 3.x line used by Avalonia 12. -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <!-- Includes LibRaw 0.22.x for RAW fallback decoding (F1-3); LGPL parts statically linked: see risk R19. -->
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <!-- CUDA 13 + cuDNN 9 build, includes the CPU provider (decision F1-2). -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.31.0" />
    <!-- Level D captions only, in the PhotoFlow.Vlm process (phase 5b, decision U4); MIT; needs ORT GPU >= 1.30. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntimeGenAI.Cuda" Version="0.17.1" />
  </ItemGroup>

  <ItemGroup Label="Ingest and catalog">
    <PackageVersion Include="System.IO.Hashing" Version="10.0.12" />
    <!-- DPAPI for the fingerprint key (spec §7, D12; MIT). -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xunit.v3 4.x breaks Avalonia.Headless.XUnit 12.x (AvaloniaUI/Avalonia#22072): keep 3.2.2. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
  </ItemGroup>
</Project>
