<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>

    <Authors>Foyer Labs</Authors>
    <Company>Foyer Labs</Company>
    <Product>PhotoFlow Studio</Product>
    <Version>0.2.1</Version>
    <Copyright>Copyright 2026 Foyer Labs</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/foyer-labs/PhotoFlow-Studio</RepositoryUrl>
  </PropertyGroup>
</Project>
