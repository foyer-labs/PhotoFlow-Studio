<!--
  Design tokens of spec §12bis — the single source of colors, typography, spacing, radii and elevation.
  Views reference these keys only; no color is ever written in a view (CLAUDE.md §5).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <ResourceDictionary.ThemeDictionaries>

    <!-- Dark theme (default): neutral greys that do not bias photo colors -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PF.Color.Viewer">#0E0E0E</Color>
      <!-- Modal veil: black 60 %, no blur (board 2g) -->
      <Color x:Key="PF.Color.Veil">#99000000</Color>
      <Color x:Key="PF.Color.GridArea">#151515</Color>
      <Color x:Key="PF.Color.Window">#1B1B1B</Color>
      <Color x:Key="PF.Color.Panel">#222222</Color>
      <Color x:Key="PF.Color.Control">#2B2B2B</Color>
      <Color x:Key="PF.Color.ControlHover">#363636</Color>
      <Color x:Key="PF.Color.Border">#303030</Color>
      <Color x:Key="PF.Color.BorderStrong">#4A4A4A</Color>
      <Color x:Key="PF.Color.TextPrimary">#EDEDED</Color>
      <Color x:Key="PF.Color.TextSecondary">#A6A6A6</Color>
      <Color x:Key="PF.Color.TextTertiary">#808080</Color>
      <Color x:Key="PF.Color.Accent">#5E9EEA</Color>
      <Color x:Key="PF.Color.PrimaryAction">#E6E6E6</Color>
      <Color x:Key="PF.Color.PrimaryActionText">#111111</Color>
      <Color x:Key="PF.Color.Outcome.Discard">#EB5A50</Color>
      <Color x:Key="PF.Color.Outcome.ToReview">#E9B13C</Color>
      <Color x:Key="PF.Color.Outcome.Best">#4CC38A</Color>
      <Color x:Key="PF.Color.Outcome.Similar">#9C9AE0</Color>
      <Color x:Key="PF.Color.Outcome.Kept">#3A3A3A</Color>

      <!-- Brushes of this variant -->
      <SolidColorBrush x:Key="PF.Brush.Viewer" Color="{StaticResource PF.Color.Viewer}" />
      <SolidColorBrush x:Key="PF.Brush.Veil" Color="{StaticResource PF.Color.Veil}" />
      <SolidColorBrush x:Key="PF.Brush.GridArea" Color="{StaticResource PF.Color.GridArea}" />
      <SolidColorBrush x:Key="PF.Brush.Window" Color="{StaticResource PF.Color.Window}" />
      <SolidColorBrush x:Key="PF.Brush.Panel" Color="{StaticResource PF.Color.Panel}" />
      <SolidColorBrush x:Key="PF.Brush.Control" Color="{StaticResource PF.Color.Control}" />
      <SolidColorBrush x:Key="PF.Brush.ControlHover" Color="{StaticResource PF.Color.ControlHover}" />
      <SolidColorBrush x:Key="PF.Brush.Border" Color="{StaticResource PF.Color.Border}" />
      <SolidColorBrush x:Key="PF.Brush.BorderStrong" Color="{StaticResource PF.Color.BorderStrong}" />
      <SolidColorBrush x:Key="PF.Brush.TextPrimary" Color="{StaticResource PF.Color.TextPrimary}" />
      <SolidColorBrush x:Key="PF.Brush.TextSecondary" Color="{StaticResource PF.Color.TextSecondary}" />
      <SolidColorBrush x:Key="PF.Brush.TextTertiary" Color="{StaticResource PF.Color.TextTertiary}" />
      <SolidColorBrush x:Key="PF.Brush.Accent" Color="{StaticResource PF.Color.Accent}" />
      <SolidColorBrush x:Key="PF.Brush.PrimaryAction" Color="{StaticResource PF.Color.PrimaryAction}" />
      <SolidColorBrush x:Key="PF.Brush.PrimaryActionText" Color="{StaticResource PF.Color.PrimaryActionText}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Discard" Color="{StaticResource PF.Color.Outcome.Discard}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.ToReview" Color="{StaticResource PF.Color.Outcome.ToReview}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Best" Color="{StaticResource PF.Color.Outcome.Best}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Similar" Color="{StaticResource PF.Color.Outcome.Similar}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Kept" Color="{StaticResource PF.Color.Outcome.Kept}" />
      <SolidColorBrush x:Key="PF.Brush.State.Info" Color="{StaticResource PF.Color.Accent}" />
      <SolidColorBrush x:Key="PF.Brush.State.Warning" Color="{StaticResource PF.Color.Outcome.ToReview}" />
      <SolidColorBrush x:Key="PF.Brush.State.Error" Color="{StaticResource PF.Color.Outcome.Discard}" />
    </ResourceDictionary>

    <!-- Light theme: the viewer stays dark (exposure is always judged on a neutral dark background) -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PF.Color.Viewer">#2A2A2A</Color>
      <Color x:Key="PF.Color.Veil">#99000000</Color>
      <Color x:Key="PF.Color.GridArea">#DCDCDC</Color>
      <Color x:Key="PF.Color.Window">#F2F2F2</Color>
      <Color x:Key="PF.Color.Panel">#FAFAFA</Color>
      <Color x:Key="PF.Color.Control">#E8E8E8</Color>
      <Color x:Key="PF.Color.ControlHover">#DEDEDE</Color>
      <Color x:Key="PF.Color.Border">#D4D4D4</Color>
      <Color x:Key="PF.Color.BorderStrong">#ABABAB</Color>
      <Color x:Key="PF.Color.TextPrimary">#1A1A1A</Color>
      <Color x:Key="PF.Color.TextSecondary">#4F4F4F</Color>
      <Color x:Key="PF.Color.TextTertiary">#6B6B6B</Color>
      <Color x:Key="PF.Color.Accent">#1F6FD1</Color>
      <Color x:Key="PF.Color.PrimaryAction">#1A1A1A</Color>
      <Color x:Key="PF.Color.PrimaryActionText">#FAFAFA</Color>
      <Color x:Key="PF.Color.Outcome.Discard">#C8372D</Color>
      <Color x:Key="PF.Color.Outcome.ToReview">#A86F00</Color>
      <Color x:Key="PF.Color.Outcome.Best">#1E8A55</Color>
      <Color x:Key="PF.Color.Outcome.Similar">#5F5BB8</Color>
      <Color x:Key="PF.Color.Outcome.Kept">#D4D4D4</Color>

      <!-- Brushes of this variant -->
      <SolidColorBrush x:Key="PF.Brush.Viewer" Color="{StaticResource PF.Color.Viewer}" />
      <SolidColorBrush x:Key="PF.Brush.Veil" Color="{StaticResource PF.Color.Veil}" />
      <SolidColorBrush x:Key="PF.Brush.GridArea" Color="{StaticResource PF.Color.GridArea}" />
      <SolidColorBrush x:Key="PF.Brush.Window" Color="{StaticResource PF.Color.Window}" />
      <SolidColorBrush x:Key="PF.Brush.Panel" Color="{StaticResource PF.Color.Panel}" />
      <SolidColorBrush x:Key="PF.Brush.Control" Color="{StaticResource PF.Color.Control}" />
      <SolidColorBrush x:Key="PF.Brush.ControlHover" Color="{StaticResource PF.Color.ControlHover}" />
      <SolidColorBrush x:Key="PF.Brush.Border" Color="{StaticResource PF.Color.Border}" />
      <SolidColorBrush x:Key="PF.Brush.BorderStrong" Color="{StaticResource PF.Color.BorderStrong}" />
      <SolidColorBrush x:Key="PF.Brush.TextPrimary" Color="{StaticResource PF.Color.TextPrimary}" />
      <SolidColorBrush x:Key="PF.Brush.TextSecondary" Color="{StaticResource PF.Color.TextSecondary}" />
      <SolidColorBrush x:Key="PF.Brush.TextTertiary" Color="{StaticResource PF.Color.TextTertiary}" />
      <SolidColorBrush x:Key="PF.Brush.Accent" Color="{StaticResource PF.Color.Accent}" />
      <SolidColorBrush x:Key="PF.Brush.PrimaryAction" Color="{StaticResource PF.Color.PrimaryAction}" />
      <SolidColorBrush x:Key="PF.Brush.PrimaryActionText" Color="{StaticResource PF.Color.PrimaryActionText}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Discard" Color="{StaticResource PF.Color.Outcome.Discard}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.ToReview" Color="{StaticResource PF.Color.Outcome.ToReview}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Best" Color="{StaticResource PF.Color.Outcome.Best}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Similar" Color="{StaticResource PF.Color.Outcome.Similar}" />
      <SolidColorBrush x:Key="PF.Brush.Outcome.Kept" Color="{StaticResource PF.Color.Outcome.Kept}" />
      <SolidColorBrush x:Key="PF.Brush.State.Info" Color="{StaticResource PF.Color.Accent}" />
      <SolidColorBrush x:Key="PF.Brush.State.Warning" Color="{StaticResource PF.Color.Outcome.ToReview}" />
      <SolidColorBrush x:Key="PF.Brush.State.Error" Color="{StaticResource PF.Color.Outcome.Discard}" />
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>


  <!-- Typography: IBM Plex Sans + Mono (OFL), embedded -->
  <FontFamily x:Key="PF.Font.Sans">avares://PhotoFlow.App/Assets/Fonts#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="PF.Font.Mono">avares://PhotoFlow.App/Assets/Fonts#IBM Plex Mono</FontFamily>
  <x:Double x:Key="PF.FontSize.PageTitle">24</x:Double>
  <x:Double x:Key="PF.LineHeight.PageTitle">32</x:Double>
  <x:Double x:Key="PF.FontSize.SectionTitle">18</x:Double>
  <x:Double x:Key="PF.LineHeight.SectionTitle">24</x:Double>
  <x:Double x:Key="PF.FontSize.Subtitle">15</x:Double>
  <x:Double x:Key="PF.LineHeight.Subtitle">22</x:Double>
  <x:Double x:Key="PF.FontSize.Body">13</x:Double>
  <x:Double x:Key="PF.LineHeight.Body">20</x:Double>
  <x:Double x:Key="PF.FontSize.Label">12</x:Double>
  <x:Double x:Key="PF.LineHeight.Label">16</x:Double>
  <x:Double x:Key="PF.FontSize.Data">12</x:Double>
  <x:Double x:Key="PF.LineHeight.Data">16</x:Double>
  <x:Double x:Key="PF.FontSize.Micro">11</x:Double>
  <x:Double x:Key="PF.LineHeight.Micro">14</x:Double>

  <!-- Spacing scale (base 4) -->
  <x:Double x:Key="PF.Space.4">4</x:Double>
  <x:Double x:Key="PF.Space.8">8</x:Double>
  <x:Double x:Key="PF.Space.12">12</x:Double>
  <x:Double x:Key="PF.Space.16">16</x:Double>
  <x:Double x:Key="PF.Space.24">24</x:Double>
  <x:Double x:Key="PF.Space.32">32</x:Double>
  <x:Double x:Key="PF.Space.48">48</x:Double>

  <!-- Radii -->
  <CornerRadius x:Key="PF.Radius.Photo">2</CornerRadius>
  <CornerRadius x:Key="PF.Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="PF.Radius.Dialog">8</CornerRadius>

  <!-- Elevation: a single shadow for dialogs, menus and tooltips -->
  <BoxShadows x:Key="PF.Shadow.Overlay">0 8 24 0 #80000000</BoxShadows>

  <!-- Window structure -->
  <x:Double x:Key="PF.Size.TitleBar">32</x:Double>
  <x:Double x:Key="PF.Size.Navigation">184</x:Double>
  <x:Double x:Key="PF.Size.NavigationCompact">48</x:Double>
  <x:Double x:Key="PF.Size.Toolbar">40</x:Double>
  <x:Double x:Key="PF.Size.DetailsPanel">300</x:Double>
  <x:Double x:Key="PF.Size.StatusBar">24</x:Double>
  <x:Double x:Key="PF.Size.SettingsColumnMax">760</x:Double>
  <x:Double x:Key="PF.Size.ButtonMinWidth">72</x:Double>

  <!-- Motion: transitions only, ≤ 120 ms, opacity and color -->
  <sys:TimeSpan x:Key="PF.Motion.Fast">0:0:0.12</sys:TimeSpan>
</ResourceDictionary>
