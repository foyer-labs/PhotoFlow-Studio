<!-- Base styles built only from the tokens in Tokens.axaml. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Window}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource PF.Font.Sans}" />
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Body}" />
  </Style>

  <!-- Typography scale (§12bis) -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.PageTitle}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.PageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.SectionTitle}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.SectionTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subtitle">
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Subtitle}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.Subtitle}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Body}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.Body}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Label}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.Label}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.data">
    <Setter Property="FontFamily" Value="{StaticResource PF.Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Data}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.Data}" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="FontFamily" Value="{StaticResource PF.Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Micro}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.Micro}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextTertiary}" />
  </Style>

  <!-- Line icons -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <!-- Icons take the text color of the control that hosts them (list item, button). -->
    <Setter Property="Stroke" Value="{Binding $parent[TemplatedControl].Foreground}" />
  </Style>

  <!-- Navigation list -->
  <Style Selector="ListBox.navigation">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Margin" Value="4,1" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextSecondary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <!-- Shortcut hints appear on hover only, so labels keep their full width (+30% for translations). -->
  <Style Selector="ListBox.navigation ListBoxItem TextBlock.navShortcut">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:pointerover TextBlock.navShortcut">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:pointerover, ListBox.navigation ListBoxItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.ControlHover}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>
  <Style Selector="ListBox.navigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>

  <!-- Search field in the title bar -->
  <Style Selector="TextBox.search">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Label}" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Flat ghost button (navigation toggle) -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextSecondary}" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.ControlHover}" />
  </Style>
  <!-- Section header above a group of cards: micro, uppercase, tertiary -->
  <Style Selector="TextBlock.overline">
    <Setter Property="FontFamily" Value="{StaticResource PF.Font.Mono}" />
    <Setter Property="FontSize" Value="{StaticResource PF.FontSize.Micro}" />
    <Setter Property="LineHeight" Value="{StaticResource PF.LineHeight.Micro}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextTertiary}" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style Selector="TextBlock.toReview">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Outcome.ToReview}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.State.Error}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.State.Warning}" />
  </Style>

  <!-- Card: panel surface with a 1 px border; rows inside are separated by .divider borders -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
  </Style>
  <Style Selector="Border.cardError">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.State.Error}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>

  <!-- Keyboard hint badge (e.g. "Esc", "Ctrl K") inside buttons and lists -->
  <Style Selector="Border.key">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource PF.Font.Mono}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextTertiary}" />
  </Style>

  <!-- Buttons: primary (one per view), secondary, ghost -->
  <Style Selector="Button.primary, Button.secondary">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="{StaticResource PF.Size.ButtonMinWidth}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.PrimaryAction}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.PrimaryActionText}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.PrimaryAction}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.PrimaryActionText}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.ControlHover}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Thin progress bar of jobs and phases -->
  <Style Selector="ProgressBar.thin">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.Accent}" />
  </Style>

  <!-- Choice cards (selection, profiles): a ListBox whose items look like bordered tiles -->
  <Style Selector="ListBox.choices">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem">
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Panel}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>
  <Style Selector="ListBox.choices ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.ControlHover}" />
  </Style>

  <!-- Text inputs in forms -->
  <Style Selector="TextBox.field">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.BorderStrong}" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Lists of jobs: rows with two lines -->
  <Style Selector="ListBox.jobs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.jobs ListBoxItem">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
  </Style>
  <Style Selector="ListBox.jobs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
  </Style>

  <!-- Tabs of a page (settings): the selected one is underlined with the accent -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextSecondary}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.tabs ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Accent}" />
  </Style>

  <!-- Steps of a procedure: the current one is underlined with the accent -->
  <Style Selector="Border.inactive">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- Filter chips (Review, People) -->
  <Style Selector="Button.chip">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Border}" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>
  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.TextPrimary}" />
  </Style>

  <!-- Faces and people tiles: selected = accent border, focused = accent underline -->
  <Style Selector="Border.tile">
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="CornerRadius" Value="{StaticResource PF.Radius.Control}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="{DynamicResource PF.Brush.Panel}" />
  </Style>
  <Style Selector="Border.tile:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.BorderStrong}" />
  </Style>
  <!-- The face the actions apply to: clearly marked (the user found the grey border hard to see). -->
  <Style Selector="Border.tile.focused">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Accent}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
  <Style Selector="Border.tile.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource PF.Brush.Accent}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>
</Styles>
